<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Declared here, not left to the host: Flutter app templates only
	     put INTERNET in the debug and profile manifests, so a release
	     build of a host that never declares it cannot open a socket. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

	<application>
		<!--
		  Declared by the plugin rather than left to each app: the tunnel
		  cannot start without it, and a missing declaration fails at runtime
		  with no build-time warning. An app that needs a different
		  foregroundServiceType can override it with tools:replace.
		-->
		<!--
		  Its own process, not the host's. The Xray core is a Go runtime, and
		  so is wireguard-go: two in one process is unsupported upstream
		  (golang/go#65050), and the second one to run takes a SIGSEGV. Apple
		  is immune only because each tunnel gets its own Network Extension
		  process, which this mirrors. Nothing in the host process may touch an
		  XRay class; see VlessIpc.
		-->
		<service
			android:name="network.mysterium.vless_dart.VlessVpnService"
			android:exported="false"
			android:foregroundServiceType="systemExempted"
			android:permission="android.permission.BIND_VPN_SERVICE"
			android:process=":vless">
			<intent-filter>
				<action android:name="android.net.VpnService" />
			</intent-filter>
			<!--
			  The intent filter above is what makes the service eligible for
			  Always-on VPN, but a system-initiated start has no config to
			  bring up and stops again immediately. With "block connections
			  without VPN" that leaves the device offline, so the capability
			  is declined until a config can be restored without a Dart call.
			-->
			<meta-data
				android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
				android:value="false" />
		</service>
	</application>
</manifest>
