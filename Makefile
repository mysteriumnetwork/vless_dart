.DEFAULT_GOAL := test

# ─── Setup ───────────────────────────────────────────────────────────────────
# Everything a fresh clone needs to build.
init:
	fvm flutter pub get

init-example: init
	cd example && fvm flutter pub get

clean:
	fvm flutter clean
	cd example && fvm flutter clean

# ─── Quality ───────────────────────────────────────────────────────────────────
format:
	fvm dart format --line-length 100 .

analyze:
	fvm flutter analyze

test: init
	fvm flutter test

# Swift tests for the plugin's control plane, hosted by the macOS example.
# They cannot run via `swift test`: the package depends on FlutterFramework,
# which only exists inside a Flutter build.
#
# Flutter hardcodes macOS 10.15 in the package it generates, which Xcode clamps
# to 12.0 — below this package's floor, so the test action refuses to link our
# product. Building tolerates the mismatch; only testing fails. That file is
# ephemeral and gitignored, so raise it in place, reading the floor from
# Package.swift rather than repeating it.
FGPSP = example/macos/Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage/Package.swift
MACOS_FLOOR = $(shell sed -n 's/.*\.macOS("\([0-9.]*\)").*/\1/p' darwin/vless_dart/Package.swift)

# Signed by default, so the build these tests leave behind can still bring a
# tunnel up. CI has no identity and passes SWIFT_TEST_SIGNING=off: the tests
# reach nothing an entitlement guards, and a host with signing switched off
# carries none, so it launches where an ad-hoc signed one would be refused.
ifeq ($(SWIFT_TEST_SIGNING),off)
SWIFT_SIGNING_FLAGS = CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=
else
SWIFT_SIGNING_FLAGS = -allowProvisioningUpdates
endif

test-swift: init-example
	@# A fresh checkout has no generated package yet, and the pin below needs one.
	cd example && fvm flutter build macos --debug --config-only
	@if [ -f $(FGPSP) ]; then \
	  sed -i '' 's/\.macOS("[0-9.]*")/.macOS("$(MACOS_FLOOR)")/' $(FGPSP); \
	  echo "==> pinned generated plugin package to macOS $(MACOS_FLOOR)"; \
	fi
	cd example/macos && xcodebuild test -workspace Runner.xcworkspace -scheme Runner \
	  -destination 'platform=macOS,arch=arm64' $(SWIFT_SIGNING_FLAGS) -quiet

# The plugin's Kotlin and AIDL, built as an app builds them, then its JVM unit
# tests. The wrapper is generated by the first Flutter build, so that goes first.
test-android: init-example
	cd example && fvm flutter build apk --debug
	cd example/android && ./gradlew :vless_dart:testDebugUnitTest

# format + analyze + the Dart, Swift and Kotlin suites, as CI would run it
check: format analyze test test-swift test-android

# ─── Example app ─────────────────────────────────────────────────────────────────
run-example: init-example
	cd example && fvm flutter run

# ─── macOS run ───────────────────────────────────────────────────────────────────
# `flutter build macos` writes to example/build/macos, but LaunchServices
# resolves the packet tunnel extension to whichever .appex path it registered
# first — usually a stale copy under DerivedData. Running the fresh app then
# silently loads the OLD extension, which costs hours to spot. So: build, sync
# the bundle over the registered path, and launch from there.
MACOS_APP      := example/build/macos/Build/Products/Debug/vless_dart_example.app
MACOS_REGISTERED := $(shell ls -d ~/Library/Developer/Xcode/DerivedData/Runner-*/Build/Products/Debug/vless_dart_example.app 2>/dev/null | head -1)

build-macos: init-example
	cd example && fvm flutter build macos --debug $(flags)

# Builds, syncs to the registered bundle, and launches it.
run-macos: build-macos
	@test -n "$(MACOS_REGISTERED)" || { \
	  echo "No registered bundle found under DerivedData."; \
	  echo "Open example/macos/Runner.xcworkspace and build once, then retry."; \
	  exit 1; }
	@echo "==> syncing to $(MACOS_REGISTERED)"
	@rm -rf "$(MACOS_REGISTERED)"
	@rsync -a "$(MACOS_APP)/" "$(MACOS_REGISTERED)/"
	@echo "==> launching"
	@"$(MACOS_REGISTERED)/Contents/MacOS/vless_dart_example"

# Same, but connects on launch — for a hands-free check.
run-macos-auto: flags=--dart-define=VLESS_AUTOCONNECT=true
run-macos-auto: run-macos

# Streams the tunnel extension's os_log. Run in a second terminal.
tunnel-logs:
	log stream --style compact --info --debug \
	  --predicate 'process == "XrayTunnelMac" OR process == "XrayTunnel" OR process == "nesessionmanager"'

# Confirms traffic actually leaves through the tunnel.
exit-ip:
	@curl -s --max-time 10 https://api.ipify.org; echo
