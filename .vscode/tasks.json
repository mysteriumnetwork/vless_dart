            "command": "\"${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb\" logcat -v time GoLog:V VlessBackend:V VlessVpnService:V VlessDartPlugin:V VlessNotification:V flutter:V '*:S'",
