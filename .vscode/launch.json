{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "macOS-debug",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "deviceId": "macos"
        },
        {
            "name": "macOS-profile",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "deviceId": "macos"
        },
        {
            "name": "macOS-release",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "deviceId": "macos"
        },
        {
            "name": "iOS-debug",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "name": "iOS-profile",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "iOS-release (memory measurement)",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "release"
        },
        {
            "name": "Android-debug",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define=VLESS_URI=${input:vlessUri}"
            ]
        },
        {
            "name": "Android-profile",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=VLESS_URI=${input:vlessUri}"
            ]
        },
        {
            "name": "Android-release",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=VLESS_URI=${input:vlessUri}"
            ]
        },
        {
            "name": "Windows-debug",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "deviceId": "windows",
            "toolArgs": [
                "--dart-define=VLESS_URI=${input:vlessUri}"
            ]
        },
        {
            "name": "Windows-profile",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "deviceId": "windows",
            "toolArgs": [
                "--dart-define=VLESS_URI=${input:vlessUri}"
            ]
        },
        {
            "name": "Windows-release",
            "request": "launch",
            "type": "dart",
            "cwd": "example",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "deviceId": "windows",
            "toolArgs": [
                "--dart-define=VLESS_URI=${input:vlessUri}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "vlessUri",
            "type": "promptString",
            "description": "vless:// URI - credentials rotate per connect, so paste a fresh one. Empty uses the sample in main.dart.",
            "default": ""
        }
    ]
}
